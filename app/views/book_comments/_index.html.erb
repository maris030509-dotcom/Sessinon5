<% @book.book_comments.each do |book_comment| %>
  <tr class="border-top border-bottom">
    <td class="fw-bolder p-2">
      <%= link_to user_path(book_comment.user) do %>
        <%= image_tag book_comment.user.get_profile_image(80,80) %>
      <% end %>
    </td>

    <td class="fw-bolder p-2">
      <%= book_comment.comment %>
    </td>

    <% if book_comment.user == current_user %>
      <td>
        <%= link_to "Destroy", book_book_comment_path(@book, book_comment), method: :delete, data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？"}, class: "btn", style: "background-color: #ff0000; color: white;" %>
      </td>
    <% end %>
              
  </tr>
<% end %>