<h2>Follower Users</h2>

<% if @users.exists? %>
  <table class="table bg-white">
    <thead>
      <tr class="border-top border-bottom">
        <th class="fw-bolder p-2">image</th>
        <th class="fw-bolder p-2">name</th>
        <th class="fw-bolder p-2"></th>
        <th class="fw-bolder p-2"></th>
        <th class="fw-bolder p-2"></th>
        <th class="fw-bolder p-2"></th>
      </tr>
    </thead>

    <tbody>
      <% @users.each do |user| %>
        <tr class="border-top border-bottom">
          <td class="fw-bolder p-2">
            <%= image_tag user.get_profile_image(100, 100), class: "profile-img" %>
          </td>
          <td class="fw-bolder p-2"><%= user.name %></td>

          <td>
            フォロー数：<%= user.followings.count %><br>
            フォロワー数：<%= user.followers.count %>
          </td>

          <td>
            <% if current_user != user %>
              <% if current_user.following?(user) %>
                <% relationship = current_user.active_relationships.find_by(followed_id: user.id) %>
                <%= link_to "フォローを外す",
                    user_relationship_path(user, relationship),
                    data: { turbo_method: :delete } %>
              <% else %>
                <%= link_to "フォローする",
                    user_relationships_path(user),
                    data: { turbo_method: :post } %>
              <% end %>
            <% end %>
          </td>

          <td class="fw-bolder p-2">
            <%= link_to "Show", user_path(user) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% else %>
  <p>ユーザーはいません</p>
<% end %>